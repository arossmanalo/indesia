{
  "name": "@indesia/api",
  "version": "0.0.0",
  "private": true,
  "description": "Indesia HTTP API (Hono), deployed as a Vercel Function.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
