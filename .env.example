# Postgres connection string (Neon). On Vercel this is injected by the Neon Marketplace
# integration. Leave empty locally to use the embedded PGlite database in apps/api/.data.
DATABASE_URL=

# Signs session cookies. Required in production: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://indesia.example.com (defaults to localhost:5173).
BETTER_AUTH_URL=

# Optional: let guests link GitHub / Google to keep progress across devices.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and .../callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
