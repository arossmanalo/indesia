{
  "name": "indesia",
  "version": "0.0.0",
  "private": true,
  "description": "Indesia: a pixel-art fantasy tower defense game for the browser.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @indesia/client build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json && tsc -p tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "art": "tsx tools/art/generate.ts",
    "map": "tsx tools/maps/ascii-to-tiled.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.x",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
